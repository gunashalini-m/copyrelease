{
  "name": "9c4e2a71-8b3d-4f12-9e56-a1b2c3d4e5f6",
  "id": "/providers/Microsoft.Flow/flows/9c4e2a71-8b3d-4f12-9e56-a1b2c3d4e5f6",
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "Axis DS attachments to OneDrive",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "10.0.0.3",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "date": {
                  "description": "First day in IST (DD-MM-YYYY)",
                  "title": "Start date",
                  "type": "string",
                  "format": "date",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "DATE"
                },
                "date_1": {
                  "description": "Last day in IST; includes mail through 23:50 that day",
                  "title": "End date",
                  "type": "string",
                  "format": "date",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "DATE"
                },
                "number": {
                  "description": "Use 1 or 2 while testing",
                  "title": "Max emails",
                  "type": "number",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "NUMBER"
                }
              },
              "required": [
                "date",
                "date_1",
                "number"
              ]
            }
          }
        }
      },
      "actions": {
        "UTC_start": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@convertTimeZone(concat(formatDateTime(triggerBody()?['date'],'yyyy-MM-dd'),'T00:00:00'),'India Standard Time','UTC','yyyy-MM-ddTHH:mm:ssZ')"
        },
        "UTC_end": {
          "runAfter": {
            "UTC_start": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@convertTimeZone(concat(formatDateTime(triggerBody()?['date_1'],'yyyy-MM-dd'),'T23:50:00'),'India Standard Time','UTC','yyyy-MM-ddTHH:mm:ssZ')"
        },
        "Get_emails_V3": {
          "runAfter": {
            "UTC_end": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "GetEmailsV3"
            },
            "parameters": {
              "folderPath": "Inbox/Axis",
              "fetchOnlyUnread": false,
              "includeAttachments": true,
              "fetchOnlyWithAttachment": true,
              "importance": "Any",
              "top": "@int(triggerBody()?['number'])",
              "searchQuery": "@{concat('received:', formatDateTime(outputs('UTC_start'),'yyyy-MM-dd'), '..', formatDateTime(outputs('UTC_end'),'yyyy-MM-dd'))}"
            }
          }
        },
        "Filter_by_received_IST_range": {
          "runAfter": {
            "Get_emails_V3": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_emails_V3')?['value']",
            "where": "@and(greaterOrEquals(ticks(item()?['receivedDateTime']), ticks(outputs('UTC_start'))), lessOrEquals(ticks(item()?['receivedDateTime']), ticks(outputs('UTC_end'))))"
          }
        },
        "For_each_email": {
          "runAfter": {
            "Filter_by_received_IST_range": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@body('Filter_by_received_IST_range')",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "For_each_attachment": {
              "type": "Foreach",
              "foreach": "@coalesce(items('For_each_email')?['attachments'], items('For_each_email')?['Attachments'], json('[]'))",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Condition_DS_attachment": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "contains": [
                          "@coalesce(items('For_each_attachment')?['name'], items('For_each_attachment')?['Name'], '')",
                          "_DS_"
                        ]
                      },
                      {
                        "not": {
                          "equals": [
                            "@coalesce(items('For_each_attachment')?['isInline'], items('For_each_attachment')?['IsInline'], False)",
                            true
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Condition_has_content": {
                      "type": "If",
                      "expression": {
                        "empty": [
                          "@coalesce(items('For_each_attachment')?['contentBytes'], items('For_each_attachment')?['ContentBytes'])"
                        ]
                      },
                      "actions": {
                        "Get_Attachment_V2": {
                          "type": "OpenApiConnection",
                          "retryPolicy": {
                            "type": "None"
                          },
                          "limit": {
                            "timeout": "PT1M"
                          },
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "connectionName": "shared_office365",
                              "operationId": "GetAttachment_V2"
                            },
                            "parameters": {
                              "messageId": "@items('For_each_email')?['id']",
                              "attachmentId": "@coalesce(items('For_each_attachment')?['id'], items('For_each_attachment')?['Id'])"
                            }
                          }
                        },
                        "Create_file_after_download": {
                          "runAfter": {
                            "Get_Attachment_V2": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "retryPolicy": {
                            "type": "None"
                          },
                          "limit": {
                            "timeout": "PT1M"
                          },
                          "runtimeConfiguration": {
                            "contentTransfer": {
                              "transferMode": "Chunked"
                            }
                          },
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                              "connectionName": "shared_onedriveforbusiness",
                              "operationId": "CreateFile"
                            },
                            "parameters": {
                              "folderPath": "/Documents/Axis-DS-Attachments",
                              "name": "@coalesce(body('Get_Attachment_V2')?['name'], items('For_each_attachment')?['name'])",
                              "body": "@coalesce(body('Get_Attachment_V2')?['contentBytes'], body('Get_Attachment_V2'))"
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Create_file": {
                            "type": "OpenApiConnection",
                            "retryPolicy": {
                              "type": "None"
                            },
                            "limit": {
                              "timeout": "PT1M"
                            },
                            "runtimeConfiguration": {
                              "contentTransfer": {
                                "transferMode": "Chunked"
                              }
                            },
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                                "connectionName": "shared_onedriveforbusiness",
                                "operationId": "CreateFile"
                              },
                              "parameters": {
                                "folderPath": "/Documents/Axis-DS-Attachments",
                                "name": "@coalesce(items('For_each_attachment')?['name'], items('For_each_attachment')?['Name'])",
                                "body": "@coalesce(items('For_each_attachment')?['contentBytes'], items('For_each_attachment')?['ContentBytes'])"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_office365": {
        "connectionName": "shared_office365",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified"
      },
      "shared_onedriveforbusiness": {
        "connectionName": "shared_onedriveforbusiness",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
        "tier": "NotSpecified"
      }
    },
    "flowFailureAlertSubscribed": false,
    "isManaged": false
  }
}